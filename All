        "# ============================================================\n",
        "# ORTHOGONALITY TEST\n",
        "# ============================================================\n",
        "\n",
        "QTQ = Q.T @ Q\n",
        "identity = np.eye(2)\n",
        "\n",
        "print(\"Q^T Q =\")\n",
        "print(QTQ)\n",
        "\n",
        "print(\"\\nIdentity matrix I =\")\n",
        "print(identity)\n",
        "\n",
        "print(\"\\nIs Q^T Q = I?\")\n",
        "print(np.allclose(QTQ, identity))\n",
        "\n",
        "print(\"\\nTherefore, Q is an orthogonal matrix.\")"
      ],
      "metadata": {
