        "# ============================================================\n",
        "# ROTATION MATRIX\n",
        "# ============================================================\n",
        "\n",
        "def rotation_matrix(angle_degrees, direction=\"CCW\"):\n",
        "\n",
        "    angle = np.radians(angle_degrees)\n",
        "\n",
        "    if direction.upper() == \"CW\":\n",
        "        angle = -angle\n",
        "\n",
        "    Q = np.array([\n",
        "        [np.cos(angle), -np.sin(angle)],\n",
        "        [np.sin(angle),  np.cos(angle)]\n",
        "    ])\n",
        "\n",
        "    return Q\n",
        "\n",
        "\n",
        "Q = rotation_matrix(\n",
        "    ANGLE_DEGREES,\n",
        "    ROTATION_DIRECTION\n",
        ")\n",
        "\n",
        "print(\"Rotation Matrix Q:\")\n",
        "print(Q)"
      ],
      "metadata": {
