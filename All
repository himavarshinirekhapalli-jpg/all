        "# ============================================================\n",
        "# QUADRATIC FORM INVARIANCE\n",
        "# ============================================================\n",
        "\n",
        "I = np.eye(2)\n",
        "\n",
        "def quadratic_form(x, A=I):\n",
        "    \"\"\"\n",
        "    Calculate q(x) = x^T A x\n",
        "    \"\"\"\n",
        "    return x.T @ A @ x\n",
        "\n",
        "print(\"Quadratic form: q(x) = x^T I x = x1^2 + x2^2\")\n",
        "print(\"-\" * 65)\n",
        "print(f\"{'Point':<10}{'q(original)':>18}{'q(rotated)':>18}\")\n",
        "\n",
        "for i in range(len(TEST_POINTS)):\n",
        "    q_original = quadratic_form(TEST_POINTS[i])\n",
        "    q_rotated = quadratic_form(ROTATED_POINTS[i])\n",
        "\n",
        "    print(\n",
        "        f\"{i:<10}\"\n",
        "        f\"{q_original:>18.4f}\"\n",
        "        f\"{q_rotated:>18.4f}\"\n",
        "    )\n",
        "\n",
        "print(\"\\nQuadratic form is invariant:\",\n",
        "      all(\n",
        "          np.isclose(\n",
        "              quadratic_form(TEST_POINTS[i]),\n",
        "              quadratic_form(ROTATED_POINTS[i])\n",
        "          )\n",
        "          for i in range(len(TEST_POINTS))\n",
        "      ))"
      ],
